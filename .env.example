# AgentPeXI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
VOYAGE_API_KEY=pa-...

# ── Ollama (local LLM, zero cost) ──────────────────────────────────────────
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
# -1 = keep model loaded forever while running; 0 = unload immediately; N = seconds
OLLAMA_KEEP_ALIVE=-1

# ── Etsy ────────────────────────────────────────────────────────────────────
ETSY_API_KEY=your_etsy_api_key
ETSY_API_SECRET=your_etsy_api_secret
ETSY_SHOP_ID=your_shop_id
ETSY_ENV=sandbox   # sandbox | production

# ── Pinterest ───────────────────────────────────────────────────────────────
# OAuth Standard Access credentials from https://developers.pinterest.com/apps/
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ── Tools ───────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...
REPLICATE_API_KEY=
FAL_KEY=your_fal_key

# ── Voice ───────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=your_voice_id
# tiny | base | small | medium | large-v3 (default: base)
WHISPER_MODEL=base

# ── Telegram ────────────────────────────────────────────────────────────────
# Token from @BotFather — required for all Telegram notifications
TELEGRAM_BOT_TOKEN=your_bot_token
# Your chat ID — use @userinfobot to find it
TELEGRAM_CHAT_ID=your_chat_id

# ── Storage & Security ──────────────────────────────────────────────────────
# Absolute path to persistent storage (SSD recommended)
STORAGE_PATH=$HOME/.agentpexi-storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=your_fernet_key
# Required: 32-byte random hex salt for KDF. Generate once:
# python -c "import secrets; print(secrets.token_hex(32))"
CRYPTO_SALT=
# Internal API key for local dashboard access — use a strong random string
PERSONAL_API_KEY=your_strong_random_key

# ── Personal Domain ─────────────────────────────────────────────────────────
NOTION_API_TOKEN=
NOTION_REMINDERS_DB_ID=
# Google OAuth credentials — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth2 Playground: https://developers.google.com/oauthplayground/
GOOGLE_REFRESH_TOKEN=
# Comma-separated list of allowed filesystem paths for the personal agent
PERSONAL_ALLOWED_DIRS=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# ── Publisher delivery (B-02) ───────────────────────────────────────────────
# Controls how listings are published: csv_export | make_webhook | etsy_api | api
PUBLISHER_DELIVERY_METHOD=api
# Required only when PUBLISHER_DELIVERY_METHOD=make_webhook
MAKE_WEBHOOK_URL=

# ── System ──────────────────────────────────────────────────────────────────
PORT=8000
# Maximum number of parallel agent tasks
MAX_PARALLEL_TASKS=5
# Alert threshold in EUR for cumulative LLM cost
COST_ALERT_THRESHOLD_EUR=70
# USD → EUR conversion rate used for pricing calculations
USD_EUR_RATE=0.92
# Must match the currency configured in your Etsy Shop settings
# If your shop uses USD, recalibrate hardcoded prices and Research conversions
ETSY_SHOP_CURRENCY=EUR

# ── Tuning & Pricing (all have safe defaults) ──────────────────────────────
# Days to retain ChromaDB screen_memory entries (default: 30)
SCREEN_RETENTION_DAYS=30
# Additional app bundle IDs or names to block in screen watcher (CSV)
SCREEN_BLOCKLIST=
# Timeout in seconds for Ollama urgency classifier (default: 8)
URGENCY_OLLAMA_TIMEOUT=8
# Hour (0-23) to send MEDIUM-urgency daily digest via Telegram (default: 18)
URGENCY_MEDIUM_DIGEST_HOUR=18
# Minutes between expired-reminder checks (default: 2)
REMIND_CHECKER_INTERVAL=2
# Hours between re-pings for unacknowledged reminders (default: 1)
REMIND_UNACK_PING_HOURS=1
# Character threshold to switch to map-reduce summarisation (default: 20000)
SUMMARIZE_MAX_CHARS=20000
# Maximum chunks processed in map-reduce mode (default: 5)
SUMMARIZE_MAX_CHUNKS=5
# Single chunk size in characters for map-reduce (default: 3000)
SUMMARIZE_CHUNK_THRESHOLD=3000
# DuckDuckGo max results for quick research mode (default: 8)
DDGS_MAX_RESULTS=8
# Seconds to wait between DuckDuckGo retries on rate-limit (default: 3)
DDGS_RETRY_WAIT_SECS=3
# Days between learning-loop decay runs (default: 7)
LEARNING_DECAY_DAYS=7
# Multiplicative weight decay factor per run (default: 0.98)
LEARNING_DECAY_FACTOR=0.98
# Minimum delta to accept a new pattern (default: 0.02)
LEARNING_ACCEPTANCE_THRESHOLD=0.02
# Number of recent tasks used to calculate baseline performance (default: 10)
LEARNING_EVAL_WINDOW=10
# Days to retain shared_memory cross-domain bridge entries (default: 90)
SHARED_MEMORY_DECAY_DAYS=90
# Path to knowledge base / Obsidian vault (relative to project root or absolute)
WIKI_BASE_PATH=knowledge_base
# Anthropic Claude Sonnet pricing (USD per million tokens) — update when Anthropic changes rates
LLM_SONNET_INPUT_PRICE=3.0
LLM_SONNET_OUTPUT_PRICE=15.0
LLM_SONNET_CACHE_READ_PRICE=0.3
LLM_SONNET_CACHE_WRITE_PRICE=3.75
# Anthropic Claude Haiku pricing (USD per million tokens)
LLM_HAIKU_INPUT_PRICE=0.80
LLM_HAIKU_OUTPUT_PRICE=4.0
LLM_HAIKU_CACHE_READ_PRICE=0.08
LLM_HAIKU_CACHE_WRITE_PRICE=1.0
