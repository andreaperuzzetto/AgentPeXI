# AgentPeXI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
VOYAGE_API_KEY=pa-...

# ── Ollama (local LLM, zero cost) ──────────────────────────────────────────
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_KEEP_ALIVE=300

# ── Etsy ────────────────────────────────────────────────────────────────────
ETSY_API_KEY=your_etsy_api_key
ETSY_API_SECRET=your_etsy_api_secret
ETSY_SHOP_ID=your_shop_id
ETSY_ENV=sandbox   # sandbox | production

# ── Pinterest ───────────────────────────────────────────────────────────────
PINTEREST_APP_ID=your_pinterest_app_id

# ── Tools ───────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...
REPLICATE_API_KEY=
FAL_KEY=your_fal_key

# ── Voice ───────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=your_voice_id
WHISPER_MODEL=small   # tiny | base | small | medium | large-v3

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Storage & Security ──────────────────────────────────────────────────────
# Absolute path to persistent storage (SSD recommended)
STORAGE_PATH=/path/to/agentpexi-storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=your_fernet_key
# Internal API key for local dashboard access — use a strong random string
PERSONAL_API_KEY=your_strong_random_key

# ── Personal Domain ─────────────────────────────────────────────────────────
NOTION_API_TOKEN=
NOTION_REMINDERS_DB_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Comma-separated list of allowed filesystem paths for the personal agent
PERSONAL_ALLOWED_DIRS=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# ── System ──────────────────────────────────────────────────────────────────
PORT=8000
MAX_PARALLEL_TASKS=5
COST_ALERT_THRESHOLD_EUR=70
